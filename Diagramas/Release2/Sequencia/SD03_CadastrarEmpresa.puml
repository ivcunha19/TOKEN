@startuml SD03_CadastrarEmpresa
!include ../estilo.iuml
title SD03 — Realizar cadastro de empresa parceira (US03)

actor "Empresa\nParceira" as E
box "View (React)" #EFF6FF
  boundary "CadastroEmpresaPage\n+ EmpresaForm" as PG
end box
box "Controller" #F5F3FF
  control "EmpresaController" as CTRL
end box
box "Service" #F5F3FF
  control "EmpresaService" as ES
end box
box "Model" #F0FDF4
  entity "e : Empresa" as EMP
end box
box "Repository" #FFF7ED
  database "UsuarioRepository" as UR
  database "EmpresaRepository" as ER
end box

E -> PG : acessa /cadastro/empresa e preenche\nnome, e-mail, CNPJ, descrição, login e senha
activate PG
PG -> PG : valida campos e dígitos do CNPJ\n(lib/documentos.js)
PG -> CTRL : POST /api/empresas (EmpresaRequestDTO)
activate CTRL
CTRL -> CTRL : @Valid (Bean Validation, @CNPJ, @Email)

alt dados inválidos
  CTRL --> PG : 400 { erro, campos }
  PG --> E : destaca os campos com erro
else dados válidos
  CTRL -> ES : criar(dto)
  activate ES
  ES -> UR : existsByLogin(login)\nexistsByEmail(email)
  UR --> ES : boolean
  ES -> ER : existsByCnpj(cnpj)
  ER --> ES : boolean
  alt login, e-mail ou CNPJ já cadastrado
    ES --> CTRL : <<exception>> RegraNegocioException
    CTRL --> PG : 422 { erro }
    PG --> E : exibe a mensagem
  else dados únicos
    create EMP
    ES -> EMP : new Empresa(nome, senha, login, email, descricao, cnpj)
    note right of EMP : senha gravada como hash BCrypt
    ES -> ER : save(e)
    ER --> ES : Empresa (com id)
    ES --> CTRL : e
    deactivate ES
    CTRL --> PG : 201 Created EmpresaResponseDTO
    deactivate CTRL
    ref over PG, CTRL : SD01 — Realizar login (entrar(login, senha) automático)
    PG --> E : redireciona para /empresa/vantagens
  end
end
deactivate PG
@enduml
